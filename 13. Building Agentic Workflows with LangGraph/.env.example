# OpenAI key: used by chat.py, chat_checkpoint.py and the first node of chat_2.py
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini key: used by the fallback node in chat_2.py
GOOGLE_API_KEY=your_gemini_api_key_here

# MongoDB credentials: used by docker-compose.yml AND chat_checkpoint.py
MONGO_USERNAME=admin
MONGO_PASSWORD=change_me
MONGO_HOST=localhost
MONGO_PORT=27017
