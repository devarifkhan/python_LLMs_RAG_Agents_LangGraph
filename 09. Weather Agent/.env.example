# Google Gemini API key (used through Gemini's OpenAI-compatible endpoint)
GOOGLE_API_KEY=your_gemini_api_key_here

# Meteosource API key, free tier: https://www.meteosource.com/client/sign-up
METEOSOURCE_API_KEY=your_meteosource_api_key_here

# Optional: when a city name matches several places, prefer this country
PREFERRED_COUNTRY=Bangladesh
